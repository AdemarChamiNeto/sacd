# Copie para .env (NUNCA commite o .env) e preencha. Usado pelo docker-compose.prod.yml.

# Domínio (o DNS precisa apontar para o servidor antes de subir: o Caddy pede o certificado HTTPS)
DOMINIO=sacdonline.com.br

# Banco — gere uma senha forte, ex.: openssl rand -base64 32
POSTGRES_DB=sacd_db
POSTGRES_USER=sacd_user
POSTGRES_PASSWORD=

# Firebase (app Web) — Console → Configurações do projeto → Seus apps. Não são segredos.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Opcionais
VITE_GA_ID=
VITE_CLARITY_ID=
VITE_CONTATO_EMAIL=

# A credencial do Firebase Admin (segredo!) NÃO vai aqui: salve o JSON em
# segredos/firebase-service-account.json (pasta ignorada pelo Git).
